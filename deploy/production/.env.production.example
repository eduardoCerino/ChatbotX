# Template for /opt/chatbotx/.env on the VPS. Never commit the real file.
# scripts/generate-env.sh fills every __GENERATE__ value with a random secret.
# Variable names and meanings follow the repo's .env.example.

# ── Deployment (compose interpolation only) ────────────────────────────────
APP_DOMAIN=chatbot.peachperfect.com.mx
S3_DOMAIN=s3.chatbot.peachperfect.com.mx
ACME_EMAIL=__ASK__
# ghcr.io/<namespace>/chatbotx-*. IMAGE_TAG is set by scripts/deploy.sh.
IMAGE_NAMESPACE=eduardocerino

# ── Edition / admin ───────────────────────────────────────────────────────
NEXT_PUBLIC_EDITION=community
PLATFORM_ADMIN_EMAIL=__ASK__
NODE_ENV=production
LOG_LEVEL=info
LOG_DEBUG=false

# ── Public URLs (read at runtime via window.__ENV, no rebuild needed) ────────
NEXT_PUBLIC_BUILDER_URL=https://chatbot.peachperfect.com.mx
BETTER_AUTH_URL=https://chatbot.peachperfect.com.mx
FORCE_PUBLIC_HTTPS=true

# ── Auth / encryption ─────────────────────────────────────────────────────
BETTER_AUTH_SECRET=__GENERATE_BASE64_32__
ENCRYPTION_KEY=__GENERATE_HEX_32__
# Set to true after creating your own account if you don't want public signups.
AUTH_DISABLE_SIGNUP=false

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=chatbotx
POSTGRES_USER=chatbotx
POSTGRES_PASSWORD=__GENERATE_HEX_24__
DATABASE_URL=postgresql://chatbotx:${POSTGRES_PASSWORD}@postgres:5432/chatbotx?schema=public
DATABASE_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=__GENERATE_HEX_24__
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── Object storage (RustFS, S3 compatible) ─────────────────────────────────
S3_ACCESS_KEY_ID=chatbotx
S3_SECRET_ACCESS_KEY=__GENERATE_HEX_24__
S3_BUCKET=chatbotx
S3_REGION=us-west-2
# Browser-reachable (presigned uploads/downloads go here) — see Caddyfile.
S3_ENDPOINT=https://s3.chatbot.peachperfect.com.mx
STORED_IMAGE_OPTIMIZATION=on

# ── Internal service secrets ──────────────────────────────────────────────
JAVASCRIPT_EXECUTOR_TOKEN=__GENERATE_HEX_32__
MAX_CONCURRENCY=1
REALTIME_BROADCAST_SECRET=__GENERATE_HEX_32__

# ── Email (required: signup needs email verification) ─────────────────────
# smtp[s]://user:pass@host:port   (URL-encode special chars in the password)
SMTP_SERVER=__ASK__
SMTP_FROM=__ASK__

# ── Misc (defaults from .env.example) ────────────────────────────────────
SCHEDULER_BUCKET_RANGE=0-255
LIVE_MEDIA_LAZY_CHANNELS=messenger,instagram
LIVE_AVATAR_LAZY_CHANNELS=messenger,instagram
